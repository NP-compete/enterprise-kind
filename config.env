# Single source of truth for the whole stack. Sourced by every script and the Makefile.
# Override any value by exporting it before running make, e.g. `BASE_DOMAIN=kind.test make up`.

CLUSTER_NAME="${CLUSTER_NAME:-kindprod}"
NODE_IMAGE="${NODE_IMAGE:-kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5}"

# Host ports published off the ingress worker.
HTTP_PORT="${HTTP_PORT:-80}"
HTTPS_PORT="${HTTPS_PORT:-443}"
API_SERVER_PORT="${API_SERVER_PORT:-6443}"

# Every platform UI is served at <name>.${BASE_DOMAIN}.
#
# Do NOT use a *.localhost domain here. Go and musl short-circuit any name
# ending in .localhost to 127.0.0.1 without consulting DNS (RFC 6761), so
# in-cluster OIDC calls to the Keycloak issuer would dial their own loopback
# and SSO breaks. `.test` is reserved for exactly this and is resolved normally.
# Run `make hosts` once to point these names at 127.0.0.1 on your Mac.
BASE_DOMAIN="${BASE_DOMAIN:-kind.test}"

# Hostnames published by the platform; used by `make hosts` and the smoke tests.
PLATFORM_HOSTS="${PLATFORM_HOSTS:-home registry flows vault keycloak auth grafana prometheus alertmanager argocd headlamp podinfo agent agent-ui}"

# Local OCI registry reachable as localhost:${REGISTRY_HOST_PORT} from the host and
# as ${REGISTRY_NAME}:5000 from inside the cluster.
REGISTRY_NAME="${REGISTRY_NAME:-kind-registry}"
REGISTRY_HOST_PORT="${REGISTRY_HOST_PORT:-5001}"

# Container engine. kind speaks to podman via KIND_EXPERIMENTAL_PROVIDER.
CONTAINER_ENGINE="${CONTAINER_ENGINE:-podman}"

# ---- identity ----
# Usernames are config; passwords are not.
#
# Leaving a password empty here means "generate a random one on first install
# and keep it in .secrets/". That file is gitignored and chmod 600, and
# `make urls` prints what was generated. Re-installs reuse the same value, so
# the credentials are stable for the life of the cluster without ever being
# written down in a tracked file.
#
# You can still pin one explicitly -- `SSO_ADMIN_PASSWORD=hunter2 make all`,
# or by filling it in below -- and an explicit value always wins. That is the
# escape hatch for a demo where a memorable password matters more than a
# secret one.
KEYCLOAK_ADMIN_USERNAME="${KEYCLOAK_ADMIN_USERNAME:-soham}"
KEYCLOAK_ADMIN_PASSWORD="${KEYCLOAK_ADMIN_PASSWORD:-}"
# The SSO account used to sign in to Grafana / Argo CD / Headlamp / Prometheus.
SSO_ADMIN_USERNAME="${SSO_ADMIN_USERNAME:-soham}"
SSO_ADMIN_PASSWORD="${SSO_ADMIN_PASSWORD:-}"
SSO_VIEWER_USERNAME="${SSO_VIEWER_USERNAME:-viewer}"
SSO_VIEWER_PASSWORD="${SSO_VIEWER_PASSWORD:-}"

# ---- chart versions (pinned; bump deliberately) ----
CHART_METRICS_SERVER="${CHART_METRICS_SERVER:-3.14.0}"
CHART_CERT_MANAGER="${CHART_CERT_MANAGER:-v1.21.3}"
CHART_INGRESS_NGINX="${CHART_INGRESS_NGINX:-4.15.1}"
CHART_KUBE_PROM_STACK="${CHART_KUBE_PROM_STACK:-92.20.0}"
CHART_LOKI="${CHART_LOKI:-7.5.0}"
# Traces. Removed during the minimal cut and brought back once the agent
# arrived -- a LangGraph app is exactly the workload you want traced.
CHART_TEMPO="${CHART_TEMPO:-1.24.4}"
CHART_ALLOY="${CHART_ALLOY:-1.15.0}"
CHART_ARGOCD="${CHART_ARGOCD:-10.14.0}"
CHART_HEADLAMP="${CHART_HEADLAMP:-0.46.0}"
CHART_KYVERNO="${CHART_KYVERNO:-3.9.2}"
# Matches the control plane's own etcd, so etcdctl always speaks the right API.
NODE_IMAGE_ETCD="${NODE_IMAGE_ETCD:-registry.k8s.io/etcd:3.7.0-0}"
SEALED_SECRETS_VERSION="${SEALED_SECRETS_VERSION:-v0.41.2}"
COSIGN_VERSION="${COSIGN_VERSION:-v2.4.3}"
# NVIDIA OpenShell: sandboxed agent workloads behind a brokered network
# boundary. Needs the Agent Sandbox controller (a Kubernetes SIG project)
# and a CNI that actually enforces NetworkPolicy -- Calico, here.
# Model the template-agent runs. Rewritten into PROMPT.md when the config
# image layer is baked, so changing it needs `make agent-stack build`.
# Gemini and Claude names route to their native providers; anything else
# goes to the OpenAI-compatible endpoint at VLLM_BASE_URL.
AGENT_MODEL="${AGENT_MODEL:-gemini-3.8-flash}"
CHART_OPENSHELL="${CHART_OPENSHELL:-0.1.7}"
AGENT_SANDBOX_VERSION="${AGENT_SANDBOX_VERSION:-v1.0.10}"
# CloudNativePG runs the platform's Postgres. One instance here: the operator
# still gives declarative provisioning, backups and a stable -rw Service, but
# with nothing to fail over to. Raise to 3 to get real failover back -- it
# only cost ~250 MiB.
CHART_CNPG="${CHART_CNPG:-0.29.1}"
# Instances in the Postgres cluster: one primary + (N-1) streaming replicas.
PG_INSTANCES="${PG_INSTANCES:-1}"
CHART_VAULT="${CHART_VAULT:-0.34.1}"
CHART_EXTERNAL_SECRETS="${CHART_EXTERNAL_SECRETS:-2.14.0}"
CHART_VELERO="${CHART_VELERO:-12.2.3}"
CHART_CALICO="${CHART_CALICO:-v3.33.0}"
CHART_KEYCLOAK="${CHART_KEYCLOAK:-7.4.0}"
CHART_OAUTH2_PROXY="${CHART_OAUTH2_PROXY:-10.7.1}"
