# Generated secret material. NEVER commit these.
#   platform-root-ca.key   signs every certificate in the cluster
#   etcd-encryption.key    decrypts every Secret in etcd
#   vault-unseal-keys.json unseals Vault
#   registry.htpasswd      registry credentials
.secrets/

# Rendered output: regenerated by the scripts on every run.
.build/
*.log

# Generated into a tracked directory by scripts/pki.sh and render-authn.sh.
# encryption-config.yaml embeds the etcd AES key -- it is NOT safe to commit.
cluster/policies/encryption-config.yaml
cluster/policies/authentication-config.yaml
cluster/policies/platform-ca.crt
