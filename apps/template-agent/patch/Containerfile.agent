# Agent image with our config and built-in tools baked in.
#
# Two things upstream's image does not have:
#   1. /app/config/agent -- the Containerfile sets CONFIG_PATH but never
#      copies config in, so the agent exits on "Missing required config".
#   2. a local tool registry -- every tool arrives over MCP. The sed below
#      is the one-line fork point that appends our built-in tools to the
#      list the graph assembles.
FROM localhost/template-agent:local

COPY --chown=65532:root config/agent /app/config/agent
COPY --chown=65532:root builtin_tools.py /app/deep_agent/src/agent/builtin_tools.py

USER 0
# The kubernetes client is not in upstream's dependency set. The venv is
# uv-managed and ships no pip, so install with uv against that interpreter
# rather than reaching for /app/.venv/bin/pip, which does not exist.
RUN uv pip install --python /app/.venv/bin/python3 --no-cache 'kubernetes>=31.0.0' \
 && /app/.venv/bin/python3 -c 'import kubernetes'

# Append built-in tools where the graph collects the MCP ones. Asserted
# rather than assumed: if upstream renames that line the build fails here
# instead of silently shipping an agent with no code-execution tool.
RUN grep -q '^    all_available_tools = list(mcp_tools)$' /app/deep_agent/aegra/graph.py \
 && sed -i 's|^    all_available_tools = list(mcp_tools)$|    from deep_agent.src.agent.builtin_tools import get_builtin_tools\n    all_available_tools = list(mcp_tools) + get_builtin_tools()|' \
      /app/deep_agent/aegra/graph.py \
 && grep -q 'get_builtin_tools()' /app/deep_agent/aegra/graph.py

USER 65532
